# Copy to .env and fill in. Never commit .env.

# ========== AI analysis ==========
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ========== Instagram Graph API ==========
IG_USER_ID=
IG_ACCESS_TOKEN=
# 토큰 발급일 YYYY-MM-DD — 만료 = 발급일 + 60일. 7일 전 PWA 경고, 10일 전 자동 갱신
IG_TOKEN_OBTAINED_AT=
# Meta 앱 (토큰 교환·갱신, debug_token 만료 조회)
FB_APP_ID=
FB_APP_SECRET=

# 예약 게시·토큰 자동 갱신 스케줄러 (API 프로세스 안에서 실행). 0 이면 끔
INSTA2_SCHEDULER=1

# Playwright 프로필 (로그인 세션 유지)
BROWSER_PROFILE_DIR=data/browser_profile

# ========== Public image host (carousel needs HTTPS URLs) ==========
# Prefer one of: IMGBB, Cloudinary, or PUBLIC_BASE_URL
IMGBB_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_BASE_URL=
PUBLIC_MEDIA_DIR=data/public

# ========== Kling (optional illustrations) ==========
# Preferred: official CLI (`npm run kling:login` → browser OAuth)
# KLING_BACKEND=auto|cli|api  (default auto = CLI first, REST fallback)
KLING_BACKEND=auto
KLING_CLI=
KLING_IMAGE_MODEL=
KLING_ASPECT_RATIO=3:4
KLING_POLL_SECONDS=120
# REST fallback (B2B open platform keys) — optional if CLI logged in
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_API_KEY=
KLING_SECRET_KEY=
