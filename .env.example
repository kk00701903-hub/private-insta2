# Copy to .env and fill in. Never commit .env.

# ========== AI analysis ==========
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ========== Instagram Graph API ==========
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_TOKEN_OBTAINED_AT=
# Meta 앱 (토큰 교환·갱신)
FB_APP_ID=
FB_APP_SECRET=

# Playwright 프로필 (로그인 세션 유지)
BROWSER_PROFILE_DIR=data/browser_profile

# ========== Public image host (carousel needs HTTPS URLs) ==========
# Prefer one of: IMGBB, Cloudinary, or PUBLIC_BASE_URL
IMGBB_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_BASE_URL=
PUBLIC_MEDIA_DIR=data/public

# ========== Kling (optional illustrations) ==========
# Preferred: official CLI (`npm run kling:login` → browser OAuth)
# KLING_BACKEND=auto|cli|api  (default auto = CLI first, REST fallback)
KLING_BACKEND=auto
KLING_CLI=
KLING_IMAGE_MODEL=
KLING_ASPECT_RATIO=3:4
KLING_POLL_SECONDS=120
# REST fallback (B2B open platform keys) — optional if CLI logged in
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_API_KEY=
KLING_SECRET_KEY=

# ========== 수익화: 쿠팡 파트너스 Open API (선택) ==========
# 없으면 PWA에서 제휴 링크를 직접 붙여 넣을 수 있음
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=

# ========== 수익화: 댓글→DM (Meta) ==========
# Facebook 로그인 방식 비공개 답장은 페이지 토큰 필요. 비우면 IG_ACCESS_TOKEN 으로 /me/accounts 에서 자동 조회
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# 웹훅(공개 HTTPS 주소가 있을 때만) GET 검증용 임의 문자열. POST 서명 검증은 FB_APP_SECRET 사용
META_WEBHOOK_VERIFY_TOKEN=
