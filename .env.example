# Copy to .env and fill in. Never commit .env.

# ========== AI analysis ==========
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ========== Instagram Graph API ==========
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_TOKEN_OBTAINED_AT=
# Meta 앱 (토큰 교환·갱신)
FB_APP_ID=
FB_APP_SECRET=

# Playwright 프로필 (로그인 세션 유지)
BROWSER_PROFILE_DIR=data/browser_profile

# ========== Public image host (carousel needs HTTPS URLs) ==========
# Prefer one of: IMGBB, Cloudinary, or PUBLIC_BASE_URL
IMGBB_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_BASE_URL=
PUBLIC_MEDIA_DIR=data/public

# ========== Kling (optional illustrations) ==========
# Preferred: official CLI (`npm run kling:login` → browser OAuth)
# KLING_BACKEND=auto|cli|api  (default auto = CLI first, REST fallback)
KLING_BACKEND=auto
KLING_CLI=
KLING_IMAGE_MODEL=
KLING_ASPECT_RATIO=3:4
KLING_POLL_SECONDS=120
# REST fallback (B2B open platform keys) — optional if CLI logged in
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_API_KEY=
KLING_SECRET_KEY=

# ========== AI 릴스 (PhotoCraft + Kling image-to-video) ==========
# PhotoCraft CLI: `npm run photocraft:install` puts it in tools/photocraft/ (not committed).
# Set this only to use a binary elsewhere, e.g. C:\Tools\photocraft\photocraft-cli.exe
PHOTOCRAFT_CLI=
PHOTOCRAFT_TIMEOUT=180
# Kling image-to-video model (empty = first model `kling who_am_i` lists for image_to_video)
KLING_VIDEO_MODEL=
# Clip lengths Kling may be asked for (seconds); each shot uses the shortest that covers it
KLING_VIDEO_DURATIONS=5,10
KLING_VIDEO_POLL_SECONDS=600
